&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;WAP&lt;span class="o"&gt;(&lt;/span&gt;Dopra Linux&lt;span class="o"&gt;)&lt;/span&gt; &lt;span class="c1"&gt;# ls&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;CfgFile_Backup dypack_debug mount_ok
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;CfgwithoutlineD factory_file mount_osgi_ok
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;DHCPlasterrwan1 fsok nffruntimes
